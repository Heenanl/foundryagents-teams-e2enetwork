# Copy to .env. Run as the SIGNED-IN USER (az login as that user), not a managed identity.

# Foundry project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<FOUNDRY_ACCOUNT>.services.ai.azure.com/api/projects/<PROJECT>

# A model deployment in that project.
FOUNDRY_MODEL=gpt-4.1-mini

# Name of the SharePoint (grounding) connection created in the Foundry project (see README).
SHAREPOINT_CONNECTION_NAME=my-sharepoint-connection

# The question to ask (answer should live in a doc the signed-in user can read).
QUERY=Summarize the latest document in the <SiteName> SharePoint site.
