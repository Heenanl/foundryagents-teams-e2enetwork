{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "{{BOT_APP_ID}}",
  "developer": {
    "name": "Contoso",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "SharePoint KB",
    "full": "SharePoint knowledge assistant (per-user, single-site)"
  },
  "description": {
    "short": "Ask questions grounded on one SharePoint site, trimmed to your permissions.",
    "full": "A hosted Foundry agent that answers from a single SharePoint site using the Microsoft 365 Copilot Retrieval API, on behalf of the signed-in user."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "{{BOT_APP_ID}}",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["token.botframework.com"],
  "webApplicationInfo": {
    "id": "{{BOT_APP_ID}}",
    "resource": "api://botid-{{BOT_APP_ID}}"
  }
}
