# Copy to .env and fill in. Do NOT commit .env.

# Foundry project (for the model call — authenticated with the container's managed identity).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1

# The ONE SharePoint site to scope retrieval to (KQL path filter). Trailing slash added for you.
SHAREPOINT_SITE_URL=https://<company>.sharepoint.com/sites/<site>

# Retrieval API endpoint (v1.0 default; use /beta only for preview features).
RETRIEVAL_API_URL=https://graph.microsoft.com/v1.0/copilot/retrieval

# structured_inputs key the caller uses to pass the user's Graph token.
STRUCTURED_INPUT_TOKEN_KEY=userToken

# Max extracts to retrieve (1-25).
MAX_RESULTS=10
