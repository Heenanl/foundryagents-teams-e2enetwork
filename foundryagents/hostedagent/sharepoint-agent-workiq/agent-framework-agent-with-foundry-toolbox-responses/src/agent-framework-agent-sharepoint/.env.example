# Copy to .env for local runs (python main.py). When deployed as a hosted agent,
# the platform injects FOUNDRY_PROJECT_ENDPOINT and the values set in azure.yaml.

# Foundry project that owns the toolbox and the deployed model.
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<FOUNDRY_ACCOUNT>.services.ai.azure.com/api/projects/<PROJECT>

# Model deployment name in the project above (must exist).
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1

# Toolbox name created via azure.yaml / azd ai toolbox (the SharePoint Work IQ tools).
TOOLBOX_NAME=sharepoint-tools

# Set to false to run as a plain chat assistant with no toolbox (smoke test).
ENABLE_TOOLBOX=true
