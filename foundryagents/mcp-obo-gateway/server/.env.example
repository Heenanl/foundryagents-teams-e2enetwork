# Copy to .env; do NOT commit .env.

# The gateway's own Entra app (confidential client) used for the OBO exchange.
GATEWAY_TENANT_ID=<tenant-guid>
GATEWAY_CLIENT_ID=<gateway-app-client-id>
# Secret path (dev). Leave empty to use the secret-less federated path below.
GATEWAY_CLIENT_SECRET=<gateway-app-secret>
# Federated (hardened) path: the managed identity the gateway app federates to. Empty = default MI.
GATEWAY_MI_CLIENT_ID=

# Verify inbound tokens (audience/issuer/scope). Set false ONLY for local testing without a token.
VERIFY_TOKENS=true
REQUIRED_SCOPES=access_as_user
# Public URL of this gateway (RFC 9728 metadata). e.g. https://<gateway-host>
SERVER_URL=

# Which downstream providers to expose (providers/<name>.py). Comma-separated.
ENABLED_PROVIDERS=whoami,copilot_retrieval

# --- copilot_retrieval provider config ---
SHAREPOINT_SITE_URL=https://<company>.sharepoint.com/sites/<site>
RETRIEVAL_API_URL=https://graph.microsoft.com/v1.0/copilot/retrieval
MAX_RESULTS=10

PORT=8000
